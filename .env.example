# Set the site owner's email address to receive enquiry emails (used by FormSubmit / mailto fallback)
VITE_OWNER_EMAIL=owner@yourdomain.com

# Optional: Set a custom form service API URL (e.g., Formspree, FormSubmit, custom backend endpoint)
VITE_FORM_ENDPOINT=

# Optional: Web3Forms Access Key (https://web3forms.com)
VITE_WEB3FORMS_KEY=
